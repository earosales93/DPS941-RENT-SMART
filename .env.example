# ============================================================================
#  RENT SMART · Configuración de Firebase
# ============================================================================
# Copia este archivo como .env y pega los valores de TU proyecto.
# Los obtienes en la consola de Firebase:
#   Configuración del proyecto -> Tus apps -> App web -> Configuración del SDK
#
# Expo inyecta en el paquete toda variable que empiece con EXPO_PUBLIC_.
# Estas claves identifican el proyecto; NO son secretas. Quien autoriza las
# operaciones son las reglas de seguridad de firestore.rules.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ============================================================================
#  Acceso con Google (opcional)
# ============================================================================
# Se obtienen en Google Cloud -> APIs y servicios -> Credenciales.
# Si se dejan vacíos, el botón de Google no se muestra y el acceso por
# correo y contraseña sigue funcionando con normalidad.

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
